# =============================================================================
# AMIGO - Local Development Secrets
# =============================================================================
# Key manifest for local Workers dev. `pnpm run dev` uses op run to inject these
# keys into process.env; Wrangler reads them via CLOUDFLARE_INCLUDE_PROCESS_ENV.
# `pnpm run dev:verify` requires the Required section only (names only; no values
# printed). Do not mount or commit `.dev.vars`.
# Deploy keys live in apps/web/.deploy.env.example and apps/web/.wrangler.secrets.example.
# =============================================================================

# -----------------------------------------------------------------------------
# Required — enough for first `pnpm run dev`
# -----------------------------------------------------------------------------
APP_ENV=development
# Must match apps/web/server/lib/dev-origin.ts (Vite dev port).
APP_ORIGIN=http://localhost:5190

# Clerk authentication (create your own Clerk application; use pk_test_ / sk_test_)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# Optional — not required for local Vite / D1
# -----------------------------------------------------------------------------
# Local `pnpm run dev` renders placeholder Cloudflare IDs into .wrangler.dev.jsonc.
# Real account/D1/KV/domain IDs are only needed for deploy / remote Wrangler.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_CUSTOM_DOMAIN=

# Web Push (VAPID) — optional unless testing push notifications.
# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Agentic login (Cursor Cloud Agents / browser automation) — optional
# -----------------------------------------------------------------------------
# Create a dedicated Clerk Development user in *your* Clerk app for agents.
# Store the credentials here (in your 1Password Environment), never in git.
# Prefer `pnpm run agent:signin-url` for browser sessions (Clerk Agent Task / ticket).
# AGENT_LOGIN_PASSWORD is last-resort form fill only and is never read by the Worker.
AGENT_LOGIN_EMAIL=
AGENT_LOGIN_PASSWORD=
