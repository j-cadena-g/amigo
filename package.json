{
  "name": "amigo",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/run-with-1password-environment.sh -- node scripts/run-vite-dev.mjs vite dev",
    "dev:verify": "bash scripts/run-with-1password-environment.sh -- node scripts/verify-dev-environment.mjs",
    "dev:setup": "bun run db:migrate:local && bun run db:seed:local",
    "dev:reset": "rm -rf .wrangler/state && bun run dev:setup",
    "build": "react-router build",
    "wrangler:deploy-config": "node scripts/render-wrangler-deploy-config.mjs",
    "deploy": "bash scripts/run-with-1password-environment.sh -- bun run deploy:internal",
    "deploy:internal": "bash scripts/deploy-with-secrets.sh",
    "db:generate": "cd packages/db && drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply amigo-db --local",
    "db:migrate:remote": "bash scripts/run-with-1password-environment.sh -- bun run db:migrate:remote:internal",
    "db:migrate:remote:internal": "bun run wrangler:deploy-config && bunx wrangler d1 migrations apply amigo-db --remote --config .wrangler.deploy.jsonc",
    "db:seed:local": "wrangler d1 execute amigo-db --local --file=packages/db/seed.sql",
    "db:studio": "cd packages/db && drizzle-kit studio",
    "typegen": "react-router typegen",
    "typecheck": "bun run typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@amigo/db": "workspace:*",
    "@clerk/backend": "^3.2.8",
    "@clerk/react-router": "^3.0.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.35",
    "lucide-react": "^1.8.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7.14.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "vite-plugin-pwa": "^1.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1",
    "@cloudflare/vitest-pool-workers": "^0.16.14",
    "@cloudflare/workers-types": "^4",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.14.0",
    "@react-router/node": "^7.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "typescript": "^6.0",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.93.0"
  },
  "packageManager": "bun@1.3.10",
  "overrides": {
    "react-router": "7.14.0",
    "@react-router/node": "7.14.0",
    "@react-router/dev": "7.14.0"
  }
}
