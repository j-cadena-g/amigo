{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "vite/client"
    ],
    "rootDirs": [".", ".react-router/types"],
    "paths": {
      "@/*": ["./*"],
      "@amigo/db": ["../../packages/db/src/index.ts"],
      "@amigo/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": [
    ".react-router/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "server/**/*.ts",
    "worker.ts",
    "worker.test.ts",
    "router-context.ts",
    "env.d.ts",
    "vite.config.ts",
    "vite.config.test.ts",
    "vitest.config.ts",
    "vitest.workers.config.ts",
    "react-router.config.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    ".wrangler"
  ]
}
