# =============================================================================
# AMIGO - Local Development Secrets
# =============================================================================
# Key manifest for local Workers dev. Mount amigo (dev) from the 1Password desktop
# app to `.dev.vars` (named pipe). `bun run dev:verify-mount` checks the mount.
# Deploy keys live in .deploy.env.example and .wrangler.secrets.example.
# =============================================================================

# Cloudflare (same account/DB/KV IDs as prod; local Vite uses simulated D1/KV)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_CUSTOM_DOMAIN=
APP_ENV=development

# Clerk authentication
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
