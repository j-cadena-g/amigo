{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Public template only. Real production identifiers are rendered into the
  // ignored .wrangler.deploy.jsonc by scripts/render-wrangler-deploy-config.mjs.
  // Keep placeholder IDs syntactically valid so local Wrangler commands work.
  "name": "amigo",
  "account_id": "00000000000000000000000000000000",
  "main": "./worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },

  "alias": {
    "virtual:react-router/server-build": "./build/server/index.js"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amigo-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "packages/db/migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],

  "ratelimits": [
    {
      "name": "RATE_LIMIT_MUTATION",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_BULK",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_SENSITIVE",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_READ",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "HOUSEHOLD",
        "class_name": "HouseholdDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HouseholdDO"]
    }
  ],

  "placement": {
    "mode": "smart"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.25
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  },

  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    { "pattern": "example.com", "custom_domain": true }
  ],

  "triggers": {
    // Sunday 03:00 UTC: audit prune. Daily 04:23 UTC: recurring (worker.ts branches on event.cron).
    "crons": ["0 3 * * SUN", "23 4 * * *"]
  },

  "vars": {
    "APP_ENV": "development",
    "APP_ORIGIN": "http://localhost:5173",
    "CLERK_PUBLISHABLE_KEY": "pk_test_replace_me"
  }
}
