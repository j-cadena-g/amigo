{
  "name": "@amigo/web",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bash ../../scripts/run-with-1password-environment.sh -- node ../../scripts/run-vite-dev.mjs vite dev",
    "dev:verify": "bash ../../scripts/run-with-1password-environment.sh -- node ../../scripts/verify-dev-environment.mjs",
    "dev:setup": "pnpm run db:migrate:local && pnpm run db:seed:local",
    "dev:reset": "rm -rf .wrangler/state && pnpm run dev:setup",
    "build": "react-router build",
    "wrangler:deploy-config": "node ../../scripts/render-wrangler-deploy-config.mjs",
    "deploy": "bash ../../scripts/run-with-1password-environment.sh -- pnpm run deploy:internal",
    "deploy:internal": "bash ../../scripts/deploy-with-secrets.sh",
    "db:migrate:local": "pnpm exec wrangler d1 migrations apply amigo-db --local --config wrangler.jsonc",
    "db:migrate:remote": "bash ../../scripts/run-with-1password-environment.sh -- pnpm run db:migrate:remote:internal",
    "db:migrate:remote:internal": "pnpm run wrangler:deploy-config && pnpm exec wrangler d1 migrations apply amigo-db --remote --config .wrangler.deploy.jsonc",
    "db:seed:local": "pnpm exec wrangler d1 execute amigo-db --local --config wrangler.jsonc --file=../../packages/db/seed.sql",
    "typegen": "react-router typegen",
    "typecheck": "pnpm run typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@amigo/db": "workspace:*",
    "@clerk/backend": "^3.10.0",
    "@clerk/react-router": "^3.5.4",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.35",
    "lucide-react": "^1.23.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.1.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1",
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@cloudflare/workers-types": "^4",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.0.1",
    "@react-router/node": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.5.0",
    "typescript": "^6.0",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.105.0"
  }
}
