# =============================================================================
# AMIGO - Local Development Secrets
# =============================================================================
# Key manifest for local Workers dev. `pnpm run dev` uses op run to inject these
# keys into process.env; Wrangler reads them via CLOUDFLARE_INCLUDE_PROCESS_ENV.
# `pnpm run dev:verify` checks names only. Do not mount or commit `.dev.vars`.
# Deploy keys live in apps/web/.deploy.env.example and apps/web/.wrangler.secrets.example.
# =============================================================================

# Cloudflare (same account/DB/KV IDs as prod; local Vite uses simulated D1/KV)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_CUSTOM_DOMAIN=
APP_ENV=development
# Must match apps/web/server/lib/dev-origin.ts (Vite dev port).
APP_ORIGIN=http://localhost:5190

# Clerk authentication
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
