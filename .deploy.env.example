# =============================================================================
# AMIGO - Deploy-time config (names only)
# =============================================================================
# Binding IDs and Worker vars rendered into .wrangler.deploy.jsonc from
# process.env (injected by op run from a 1Password Environment).
# Worker secrets are listed in .wrangler.secrets.example and uploaded on deploy
# via wrangler deploy --secrets-file (also sourced from 1Password).
# =============================================================================

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_CUSTOM_DOMAIN=
CLERK_PUBLISHABLE_KEY=
APP_ENV=production
