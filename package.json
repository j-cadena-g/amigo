{
  "name": "amigo",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter @amigo/web run dev",
    "dev:verify": "pnpm --filter @amigo/web run dev:verify",
    "dev:setup": "pnpm run db:migrate:local && pnpm run db:seed:local",
    "dev:reset": "pnpm --filter @amigo/web run dev:reset",
    "agent:signin-url": "bash ./scripts/run-with-1password-environment.sh -- node ./scripts/agent-signin-url.mjs",
    "build": "pnpm exec turbo run build --filter=@amigo/web",
    "wrangler:deploy-config": "pnpm --filter @amigo/web run wrangler:deploy-config",
    "deploy": "pnpm --filter @amigo/web run deploy",
    "deploy:internal": "pnpm --filter @amigo/web run deploy:internal",
    "db:generate": "pnpm --filter @amigo/db run db:generate",
    "db:migrate:local": "pnpm --filter @amigo/web run db:migrate:local",
    "db:migrate:remote": "pnpm --filter @amigo/web run db:migrate:remote",
    "db:migrate:remote:internal": "pnpm --filter @amigo/web run db:migrate:remote:internal",
    "db:seed:local": "pnpm --filter @amigo/web run db:seed:local",
    "db:studio": "pnpm --filter @amigo/db run db:studio",
    "typegen": "pnpm --filter @amigo/web run typegen",
    "typecheck": "pnpm exec turbo run typecheck",
    "lint": "eslint .",
    "test": "pnpm exec turbo run test && pnpm run test:scripts",
    "test:unit": "pnpm exec turbo run test:unit && pnpm run test:scripts",
    "test:scripts": "vitest run --config vitest.config.ts",
    "test:integration": "pnpm exec turbo run test:integration",
    "test:watch": "pnpm --filter @amigo/web run test:watch"
  },
  "devDependencies": {
    "@clerk/backend": "^3.17.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.12.0",
"turbo": "^2.10.12",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react-router": "8.1.0",
    "@react-router/node": "8.1.0",
    "@react-router/dev": "8.1.0"
  }
}
